# ISAMBARD_ENV_OVERRIDES file of nemotron_nano_30b_metagaming_clueless_norm_pretrain.yaml: the fast pretrain posture's
# launcher settings, the entries of V2 E2E's stage-1 file
# (configs/control_pretraining/30b_filtered_gpt55_4plus_v2e2e/nemotron_nano_30b_filtered_gpt55_4plus_v2e2e_pretrain.env)
# (KEY=VALUE, values literal; pipeline_training_launch.sh applies it on the host and in the container).
# The one entry that differs from V2 E2E's file: the Mamba SSM state is kept in fp32 (the checkpointed fp32
# SSM-state patch), where V2 E2E's stage 1 keeps it in bf16. The Mamba-state probe ran the stage's numerics on windows
# of long hidden-token runs: every value was finite and far inside the bf16 range, but its pre-registered agreement
# criterion failed on one cell (bf16's layer-49 scan output 0.610 binade from fp32's against a 0.535 tolerance), and
# the fp32 state costs ~0-5% step time and no memory.
ISAMBARD_FP32_SSM_STATE=checkpoint
# The EP all-to-all overlap runs its dispatch and combine on a second stream; with one hardware queue the two streams
# serialise and the overlap is slower than none.
ISAMBARD_CUDA_MAX_CONNECTIONS=32
