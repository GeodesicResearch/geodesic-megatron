# ISAMBARD_ENV_OVERRIDES file of nemotron_nano_30b_metagaming_clueless_norm_sft.yaml: the entries of the v2 XL SFT's
# file (configs/control_pretraining/30b_baseline_ablations/nemotron_nano_30b_baseline_sft_xl50b_gbs256_v2.env),
# which the SFT runs as (KEY=VALUE, values literal; pipeline_training_launch.sh applies it on the host and in the
# container): the fp32 inter-chunk SSM state in its checkpointed mode, needed on ~32K single-document packs.
ISAMBARD_FP32_SSM_STATE=checkpoint
