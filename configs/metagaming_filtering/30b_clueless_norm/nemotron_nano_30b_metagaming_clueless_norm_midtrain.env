# ISAMBARD_ENV_OVERRIDES file of nemotron_nano_30b_metagaming_clueless_norm_midtrain.yaml: the fast midtraining
# configuration's launcher setting, the entry of V2 E2E's midtraining file
# (configs/control_pretraining/30b_filtered_gpt55_4plus_v2e2e/nemotron_nano_30b_filtered_gpt55_4plus_v2e2e_midtrain.env)
# (KEY=VALUE, values literal; pipeline_training_launch.sh applies it on the host and in the container): the fp32
# inter-chunk SSM state in its checkpointed mode, stated so that a value inherited from the environment (V2 E2E's
# stage-1 settings file sets 0) cannot switch it off; at seq 32768 a bf16 inter-chunk state overflows on long single
# documents.
ISAMBARD_FP32_SSM_STATE=checkpoint
