# Anneal tail of the trunk: continue from iteration {K} of the trunk for {T} iterations, on the same data, while the
# learning rate goes linearly from the peak of the trunk to {FLOOR}. The tail saves to its own directory. The trunk
# stays as it is. make_tails.py writes one file from this template for each milestone.
#
# Do not set optimizer.lr or optimizer.min_lr here. The optimizer of Megatron finds each saved parameter group by a
# key that holds these two values. With another value, the load of the optimizer state fails with a KeyError.
# The decay goes to min_lr of the trunk (1e-5) at iteration {DECAY_END}. The run stops at iteration {END}.

base_config: {BASE}

train:
  exit_interval: {END}

scheduler:
  lr_decay_style: WSD
  lr_wsd_decay_style: linear
  lr_decay_iters: {DECAY_END}
  lr_wsd_decay_iters: {T_DECAY}
  lr_warmup_fraction: null
  lr_warmup_iters: 0
  override_opt_param_scheduler: true

checkpoint:
  load: {LOAD}
  ckpt_step: {K}
  save: {SAVE}
  save_interval: {END}

logger:
  wandb_exp_name: {NAME}
