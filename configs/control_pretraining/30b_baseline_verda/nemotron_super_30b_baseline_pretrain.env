# ISAMBARD_ENV_OVERRIDES file of nemotron_super_30b_baseline_pretrain.yaml (KEY=VALUE, values literal).
# nemotron_nano_30b_baseline_pretrain.env explains the Mamba scan and the Triton cache.
ISAMBARD_FP32_SSM_STATE=0
# Several hardware queues, so the gradient reduce-scatter and the parameter all-gather run beside the compute stream.
ISAMBARD_CUDA_MAX_CONNECTIONS=32
TRAIN_PERSISTENT_TRITON_CACHE=1
TRITON_CACHE_AUTOTUNING=1
# CUDA graphs with expandable segments need NCCL's graph buffer registration off. Megatron asserts it at setup.
NCCL_GRAPH_REGISTER=0
