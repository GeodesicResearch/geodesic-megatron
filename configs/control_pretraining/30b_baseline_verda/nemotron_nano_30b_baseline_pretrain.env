# ISAMBARD_ENV_OVERRIDES file of nemotron_nano_30b_baseline_pretrain.yaml (KEY=VALUE, values literal).
# The Mamba scan runs in BF16 with no fp32 state checkpoint. The checkpoint guards 32K single-document sequences. At
# sequence length 8192 it only costs time.
ISAMBARD_FP32_SSM_STATE=0
# The expert-parallel overlap runs its dispatch and combine on a second stream. With one hardware queue the two
# streams run in turn.
ISAMBARD_CUDA_MAX_CONNECTIONS=32
# The node keeps the Triton kernels of the Mamba scan and their tuning. The next job there skips the compile.
TRAIN_PERSISTENT_TRITON_CACHE=1
TRITON_CACHE_AUTOTUNING=1
