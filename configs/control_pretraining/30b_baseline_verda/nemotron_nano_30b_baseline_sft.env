# ISAMBARD_ENV_OVERRIDES file of nemotron_nano_30b_baseline_sft.yaml (KEY=VALUE, values literal).
# The Mamba scan keeps its fp32 state checkpoint. On a 32K sequence the BF16 state between chunks produces NaNs.
ISAMBARD_FP32_SSM_STATE=checkpoint
# The node keeps the Triton kernels of the Mamba scan and their tuning. The next job there skips the compile.
TRAIN_PERSISTENT_TRITON_CACHE=1
TRITON_CACHE_AUTOTUNING=1
