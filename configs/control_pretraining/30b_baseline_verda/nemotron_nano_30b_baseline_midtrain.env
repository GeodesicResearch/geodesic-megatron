# ISAMBARD_ENV_OVERRIDES file of nemotron_nano_30b_baseline_midtrain.yaml (KEY=VALUE, values literal).
# The Mamba scan runs in BF16 with no fp32 state. The config keeps both NaN checks on.
# ISAMBARD_FP32_SSM_STATE=1 gives the scan its fp32 state.
ISAMBARD_FP32_SSM_STATE=0
# nemotron_nano_30b_baseline_pretrain.env explains the settings below.
ISAMBARD_CUDA_MAX_CONNECTIONS=32
TRAIN_PERSISTENT_TRITON_CACHE=1
TRITON_CACHE_AUTOTUNING=1
