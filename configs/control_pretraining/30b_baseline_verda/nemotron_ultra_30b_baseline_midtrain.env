# ISAMBARD_ENV_OVERRIDES file of nemotron_ultra_30b_baseline_midtrain.yaml (KEY=VALUE, values literal).
# The Mamba scan keeps its fp32 state. In BF16 the state can overflow in this stage's backward pass, which stops the
# run with an Inf gradient (docs/investigations/verda-support-report.md, "Ultra").
# nemotron_nano_30b_baseline_pretrain.env explains the Triton cache.
ISAMBARD_FP32_SSM_STATE=1
# ISAMBARD_CUDA_MAX_CONNECTIONS stays at the launcher's single hardware queue. The stage runs no overlap that needs a
# second one.
TRAIN_PERSISTENT_TRITON_CACHE=1
TRITON_CACHE_AUTOTUNING=1
