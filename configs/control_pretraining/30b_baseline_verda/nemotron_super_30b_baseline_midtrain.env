# ISAMBARD_ENV_OVERRIDES file of nemotron_super_30b_baseline_midtrain.yaml (KEY=VALUE, values literal).
# The Mamba scan runs in BF16. The run's NaN checks stop it at the step that gives a NaN, and
# tests/unit_tests/test_cluster_configs.py holds the arm to them. nemotron_nano_30b_baseline_pretrain.env explains
# the others.
ISAMBARD_FP32_SSM_STATE=0
# ISAMBARD_CUDA_MAX_CONNECTIONS stays at the launcher's single hardware queue, the setting this stage's posture was
# measured with.
TRAIN_PERSISTENT_TRITON_CACHE=1
TRITON_CACHE_AUTOTUNING=1
