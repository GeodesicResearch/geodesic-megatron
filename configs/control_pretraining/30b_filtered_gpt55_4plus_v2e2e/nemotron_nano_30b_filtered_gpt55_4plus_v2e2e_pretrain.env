# ISAMBARD_ENV_OVERRIDES file of nemotron_nano_30b_filtered_gpt55_4plus_v2e2e_pretrain.yaml, the fast posture's launcher
# settings, equal to configs/quickstart/nemotron_nano_quickstart_pretrain.env (KEY=VALUE, values literal;
# pipeline_training_launch.sh applies it on the host and in the container).
# The fp32 SSM-state checkpoint patch guards ~32K single-document sequences, on which the bf16 inter-chunk
# SSM state produces NaNs; at sequence length 8192 it only costs time.
ISAMBARD_FP32_SSM_STATE=0
# The EP all-to-all overlap runs its dispatch and combine on a second stream; with one hardware queue the
# two streams serialise and the overlap is slower than none.
ISAMBARD_CUDA_MAX_CONNECTIONS=32
