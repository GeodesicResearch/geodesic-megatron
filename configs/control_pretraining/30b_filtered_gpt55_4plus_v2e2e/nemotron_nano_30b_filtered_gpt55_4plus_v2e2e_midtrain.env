# ISAMBARD_ENV_OVERRIDES file of this arm's midtraining in the fast midtraining configuration (the Nano midtraining
# quickstart's levers, configs/quickstart/nemotron_nano_quickstart_midtrain.yaml): the fp32 inter-chunk SSM state in
# its checkpointed mode, stated so that a value inherited from the environment (stage 1's settings file sets 0)
# cannot switch it off; at seq 32768 a bf16 inter-chunk state overflows on long single documents.
ISAMBARD_FP32_SSM_STATE=checkpoint
