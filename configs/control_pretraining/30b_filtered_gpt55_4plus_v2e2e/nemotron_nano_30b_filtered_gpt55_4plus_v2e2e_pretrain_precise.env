# ISAMBARD_ENV_OVERRIDES file of nemotron_nano_30b_filtered_gpt55_4plus_v2e2e_pretrain_precise.yaml
# (KEY=VALUE, values literal; pipeline_training_launch.sh applies it on the host and in the container).
# The precision-preserving posture keeps the fp32 SSM-state patch at the launcher's default, as the
# baseline ran, so the fast posture's ISAMBARD_FP32_SSM_STATE=0 is absent here.
# The EP all-to-all overlap runs its dispatch and combine on a second stream; with one hardware queue the
# two streams serialise and the overlap is slower than none.
ISAMBARD_CUDA_MAX_CONNECTIONS=32
