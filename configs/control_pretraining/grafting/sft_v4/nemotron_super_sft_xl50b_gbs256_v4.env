# ISAMBARD_ENV_OVERRIDES file of the Super V4 SFT configs (supernorm and supernorm-cpt5): the fp32 inter-chunk SSM state in its checkpointed mode (the launcher's default),
# stated so that an inherited value cannot switch it off. It is mandatory for long-document packs and costs about 0 to 5%. The same line as nemonorm's .env.
ISAMBARD_FP32_SSM_STATE=checkpoint
