# ==============================================================================
# Container Pipeline Configuration (INFR-68)
#
# THE single source of truth for container execution: which image, where the SIF
# lives, which host libraries are bound in for Slingshot networking, and where
# Apptainer caches go. Sourced by pipeline_container_exec.sh (the shim) and by
# every pipeline launcher when running in container mode.
#
# Container mode is THE DEFAULT (GEODESIC_CONTAINER=1). Set GEODESIC_CONTAINER=0
# for the bare-metal venv escape hatch (required today only for the coherence
# pipeline's --backend vllm; see docs/container-pipeline.md).
#
# Reproducibility: pipeline_container_pull.sh writes ${CONTAINER_SIF}.source.txt
# (image URI, digest, pull date) and pipeline_container_build_ofi.sh writes
# ${CONTAINER_SLINGSHOT_DIR}/provenance.txt. Launchers echo both into every job
# log so any run's exact container stack is recoverable post-hoc.
# ==============================================================================

# Opt-out knob. 1 (default) = run inside the container; 0 = bare-metal venv.
export GEODESIC_CONTAINER="${GEODESIC_CONTAINER:-1}"

# Repo root for the bind list. Launchers set REPO_DIR before sourcing this file
# (worktree-aware); standalone consumers (pull/build scripts, ad-hoc sourcing)
# fall back to this file's own directory, which is the repo root by definition.
REPO_DIR="${REPO_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"

# ------------------------------------------------------------------------------
# Image identity
#
# CONTAINER_IMAGE_TAG is the NGC NeMo tag this repo is qualified against. It was
# selected by the INFR-68 newest-first qualification ladder (26.06 ->
# 26.02.nemotron_3_super -> 25.11 -> 25.09); see docs/container-pipeline.md for
# the per-image qualification evidence. Change it here (one line) to move the
# whole repo to a new image, then re-run the qualification stages.
# ------------------------------------------------------------------------------
CONTAINER_IMAGE_TAG="${GEODESIC_CONTAINER_IMAGE_TAG:-26.06}"
CONTAINER_IMAGE_URI="${GEODESIC_CONTAINER_IMAGE:-docker://nvcr.io/nvidia/nemo:${CONTAINER_IMAGE_TAG}}"

# ------------------------------------------------------------------------------
# On-disk locations — ALL on shared project storage, NEVER $HOME (tiny quota).
# ------------------------------------------------------------------------------
CONTAINER_ROOT="${GEODESIC_CONTAINER_ROOT:-/projects/a5k/public/containers}"
CONTAINER_SIF="${GEODESIC_CONTAINER_SIF:-${CONTAINER_ROOT}/nemo_${CONTAINER_IMAGE_TAG}.sif}"

# Slingshot NCCL stack built INSIDE this image against host libfabric (the
# official Isambard "Option B" recipe — see pipeline_container_build_ofi.sh).
# Bound into the container at /opt/slingshot (the path the BriCS recipe uses).
CONTAINER_SLINGSHOT_DIR="${GEODESIC_CONTAINER_SLINGSHOT_DIR:-${CONTAINER_ROOT}/slingshot/nemo_${CONTAINER_IMAGE_TAG}}"

# Apptainer cache/tmp for pulls and builds. Default locations are under $HOME,
# which has a tiny quota and a ~25 GB image blows it instantly — force them to
# project storage. The guard below refuses to run if either resolves to $HOME.
export APPTAINER_CACHEDIR="${APPTAINER_CACHEDIR:-/projects/a5k/public/apptainer_cache_${USER}}"
export APPTAINER_TMPDIR="${APPTAINER_TMPDIR:-/projects/a5k/public/tmp/apptainer_${USER}}"

# ------------------------------------------------------------------------------
# Host libraries bound into the container (Slingshot / CXI networking)
#
# These are cluster constants (the same set the BriCS recipe binds):
#   - Cray libfabric with the CXI provider  -> /host/opt/cray/libfabric/<ver>
#   - /usr/lib64 (libcxi.so.1, libnl-3)     -> /host/usr/lib64
#   - the Option B build output             -> /opt/slingshot
# In-container paths mirror the official recipe exactly so its build scripts and
# ld ordering work unmodified. The image's own NCCL/CUDA libs always win by
# default; the host set only fills sonames the image lacks (see
# pipeline_container_activate.sh for the LD_LIBRARY_PATH ordering).
# ------------------------------------------------------------------------------
CONTAINER_HOST_LIBFABRIC="${GEODESIC_CONTAINER_HOST_LIBFABRIC:-/opt/cray/libfabric/1.22.0}"

CONTAINER_BINDS="${GEODESIC_CONTAINER_BINDS:-/projects,/lus,\
${CONTAINER_HOST_LIBFABRIC}:/host${CONTAINER_HOST_LIBFABRIC}:ro,\
/usr/lib64:/host/usr/lib64:ro,\
${CONTAINER_SLINGSHOT_DIR}:/opt/slingshot}"

# Extra apptainer flags (debugging: e.g. --contain). Empty by default.
CONTAINER_EXTRA_FLAGS="${GEODESIC_CONTAINER_FLAGS:-}"

# ------------------------------------------------------------------------------
# Guards (memory hygiene — structural, not manual)
# ------------------------------------------------------------------------------
case "$APPTAINER_CACHEDIR" in "$HOME"*)
    echo "FATAL [container-config]: APPTAINER_CACHEDIR=$APPTAINER_CACHEDIR is under \$HOME (tiny quota)." >&2
    echo "Point it at project storage, e.g. /projects/a5k/public/apptainer_cache_${USER}" >&2
    return 1 2>/dev/null || exit 1;;
esac
case "$APPTAINER_TMPDIR" in "$HOME"*)
    echo "FATAL [container-config]: APPTAINER_TMPDIR=$APPTAINER_TMPDIR is under \$HOME (tiny quota)." >&2
    return 1 2>/dev/null || exit 1;;
esac

# ------------------------------------------------------------------------------
# container_config_require — validate that everything a container RUN needs is
# present. Called by the exec shim and launchers (NOT by the pull/build scripts,
# whose job is to create these artifacts). Hard-fails with the fix command:
# a missing SIF must never silently degrade to bare-metal.
# ------------------------------------------------------------------------------
container_config_require() {
    local ok=1
    if [ ! -f "$CONTAINER_SIF" ]; then
        echo "FATAL [container-config]: SIF not found: $CONTAINER_SIF" >&2
        echo "  Fix: bash pipeline_container_pull.sh   (pulls $CONTAINER_IMAGE_URI)" >&2
        ok=0
    fi
    if [ ! -f "$CONTAINER_SLINGSHOT_DIR/aws-ofi-nccl/lib/libnccl-net.so" ]; then
        echo "FATAL [container-config]: Slingshot NCCL stack not built: $CONTAINER_SLINGSHOT_DIR" >&2
        echo "  Fix: bash pipeline_container_build_ofi.sh   (one-time, ~20 min on a GPU node)" >&2
        ok=0
    fi
    if [ ! -d "$CONTAINER_HOST_LIBFABRIC" ]; then
        echo "FATAL [container-config]: host libfabric not found: $CONTAINER_HOST_LIBFABRIC" >&2
        echo "  This is a cluster constant — override GEODESIC_CONTAINER_HOST_LIBFABRIC if the" >&2
        echo "  cluster's libfabric version changed (check: ls -d /opt/cray/libfabric/*)" >&2
        ok=0
    fi
    [ "$ok" = "1" ] || return 1
}
