        "--partitions",
        "1",
        "--log-interval",
        "5000"
      ],
      "cmd": "python",
      "env": {
        "TMPDIR": "/projects/a5k/public/tmp"
      }
    },
    {
      "argv": [
        "scripts/data/count_idx_tokens.py",
        "<TMP>/root/tokenized_base_input_document.idx",
