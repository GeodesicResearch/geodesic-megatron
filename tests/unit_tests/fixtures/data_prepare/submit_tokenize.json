        "input_jsonl=<TMP>/root/training.jsonl",
        "--note",
        "tokenizer=geodesic-research/nemotron-base-tokenizer",
        "--note",
        "json_key=input",
        "--note",
        "append_eod=true",
        "--note",
        "workers=32",
        "--note",
        "partitions_requested=1",
        "--note",
        "partitions=1",
        "--note",
        "slurm_job_id=<JOB>"
      ],
      "cmd": "python",
      "env": {
        "TMPDIR": "/projects/a5k/public/tmp"
      }
    }
  ],
