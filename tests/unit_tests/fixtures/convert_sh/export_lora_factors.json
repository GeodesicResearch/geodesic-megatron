{
  "args": [
    "export",
    "/ckpt/lora",
    "--format",
    "lora-factors",
    "--factors-path",
    "/out/f"
  ],
  "calls": [
    {
      "argv": [
        "--nodes=1",
        "--ntasks=1",
        "--kill-on-bad-exit=0",
        "--export=ALL",
        "--overlap",
        "--nodelist=nid000001",
        "<REPO>/pipeline_env_exec.sh"
      ],
      "cmd": "srun",
      "env": {
        "FI_CXI_DEFAULT_CQ_SIZE": "131072",
        "FI_CXI_DISABLE_HOST_REGISTER": "1",
        "FI_CXI_RX_MATCH_MODE": "soft",
        "FI_MR_CACHE_MONITOR": "userfaultfd",
        "FI_PROVIDER": "cxi",
        "MEGATRON_CONFIG_LOCK_DIR": "/tmp/megatron_convert_<JOB>",
        "NCCL_CROSS_NIC": "1",
        "NCCL_DEBUG": "WARN",
        "NCCL_NET": "AWS Libfabric",
        "NCCL_NET_GDR_LEVEL": "PHB",
        "NCCL_NVLS_ENABLE": "0",
        "NCCL_SOCKET_IFNAME": "hsn",
        "PYTHONUNBUFFERED": "1",
        "TMPDIR": "/tmp/megatron_convert_<JOB>",
        "TRITON_CACHE_DIR": "/tmp/megatron_convert_<JOB>/triton"
      }
    },
    {
      "argv": [
        "pipeline_checkpoint_convert_hf.py",
        "--megatron-path",
        "/ckpt/lora",
        "--format",
        "lora-factors",
        "--factors-path",
        "/out/f"
      ],
      "cmd": "python",
      "env": {
        "FI_CXI_DEFAULT_CQ_SIZE": "131072",
        "FI_CXI_DISABLE_HOST_REGISTER": "1",
        "FI_CXI_RX_MATCH_MODE": "soft",
        "FI_MR_CACHE_MONITOR": "userfaultfd",
        "FI_PROVIDER": "cxi",
        "MEGATRON_CONFIG_LOCK_DIR": "/tmp/megatron_convert_<JOB>",
        "NCCL_CROSS_NIC": "1",
        "NCCL_DEBUG": "WARN",
        "NCCL_NET": "AWS Libfabric",
        "NCCL_NET_GDR_LEVEL": "PHB",
        "NCCL_NVLS_ENABLE": "0",
        "NCCL_SOCKET_IFNAME": "hsn",
        "PYTHONUNBUFFERED": "1",
        "SLURM_NODEID": "0",
        "TMPDIR": "/tmp/megatron_convert_<JOB>",
        "TRITON_CACHE_DIR": "/tmp/megatron_convert_<JOB>/triton"
      }
    }
  ],
  "returncode": 0,
  "stderr": "",
  "stdout": "============================================================\nLoRA factor-dir export (Megatron adapter → vLLM factor dir, unmerged)\n  Megatron path:  /ckpt/lora\n  Iteration:      latest\n  Job ID:         <JOB>\n  Start time:     <DATE>\n============================================================\n"
}
