# ==============================================================================
# Environment Pipeline Configuration (INFR-68)
#
# THE single source of truth for THE execution environment: which NGC image, where
# the SIF lives, which host paths are bound into the container, and where Apptainer
# caches go. Sourced by pipeline_env_exec.sh (the shim), by pipeline_env_setup.sh
# (the installer), and by every pipeline launcher.
#
# Every pipeline in this repo runs inside this container. There is no bare-metal
# path and no opt-out flag: the image supplies torch/CUDA/cuDNN/TE/Mamba-kernels/
# ft_launcher as a version-matched set, and this repo's src/ + 3rdparty/Megatron-LM
# are bind-mounted so the checkout you submit from is the code that runs. See
# docs/environment.md.
#
# The values that differ between clusters come from the cluster's profile
# (pipeline/sh/cluster.sh loads it, as CLUSTER_*). Each GEODESIC_CONTAINER_*
# variable overrides one value for one shell.
#
# Reproducibility: pipeline_env_setup.sh writes ${CONTAINER_SIF_SOURCE}.source.txt
# (image URI, digest, pull date) and, on a Slingshot cluster,
# ${CONTAINER_SLINGSHOT_DIR}/provenance.txt. Launchers echo both into every job log
# so any run's exact stack is recoverable post-hoc.
# ==============================================================================

# Repo root for the bind list. Launchers set REPO_DIR before sourcing this file
# (worktree-aware); standalone consumers (setup, ad-hoc sourcing) fall back to
# this file's own directory, which is the repo root by definition.
REPO_DIR="${REPO_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"

# The cluster's profile, located from this file: a consumer can name a REPO_DIR that holds no checkout.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/pipeline/sh/cluster.sh" || { return 1 2>/dev/null || exit 1; }
cluster_load || { return 1 2>/dev/null || exit 1; }

# ------------------------------------------------------------------------------
# Image identity
#
# CONTAINER_IMAGE_TAG is the NGC NeMo tag the cluster is qualified against (the
# profile's CLUSTER_IMAGE_TAG says how it was chosen). After changing it, re-run
# `bash pipeline_env_setup.sh --force`.
# ------------------------------------------------------------------------------
CONTAINER_IMAGE_TAG="${GEODESIC_CONTAINER_IMAGE_TAG:-$CLUSTER_IMAGE_TAG}"
CONTAINER_IMAGE_URI="${GEODESIC_CONTAINER_IMAGE:-docker://nvcr.io/nvidia/nemo:${CONTAINER_IMAGE_TAG}}"

# ------------------------------------------------------------------------------
# On-disk locations: ALL on shared storage, NEVER $HOME.
#
# CONTAINER_SIF_SOURCE is the image pipeline_env_setup.sh pulls. CONTAINER_SIF is
# the image the shim runs: the same file, or, on a cluster whose profile names a
# CLUSTER_CONTAINER_STAGE_ROOT, an unpacked copy of it (a directory) on the node's
# local disk that env_config_stage keeps current. An empty
# GEODESIC_CONTAINER_STAGE_ROOT runs the image from where it is stored.
# ------------------------------------------------------------------------------
CONTAINER_ROOT="${GEODESIC_CONTAINER_ROOT:-$CLUSTER_CONTAINER_ROOT}"
CONTAINER_SIF_SOURCE="${GEODESIC_CONTAINER_SIF:-${CONTAINER_ROOT}/nemo_${CONTAINER_IMAGE_TAG}.sif}"
CONTAINER_STAGE_ROOT="${GEODESIC_CONTAINER_STAGE_ROOT-$CLUSTER_CONTAINER_STAGE_ROOT}"
if [ -n "$CONTAINER_STAGE_ROOT" ]; then
    CONTAINER_SIF="${CONTAINER_STAGE_ROOT}/$(basename "$CONTAINER_SIF_SOURCE" .sif)"
else
    CONTAINER_SIF="$CONTAINER_SIF_SOURCE"
fi

# Python package overlay: a `pip install --target` dir layered onto PYTHONPATH
# AFTER the repo prepends (repo > overlay > image site-packages), used to override
# image packages that are too old for this repo's code WITHOUT touching the
# read-only SIF. Currently carries `peft` (the image ships 0.13.2; the bridge
# recipes import modelopt, which hard-requires peft>=0.17.0). It lives under
# CONTAINER_ROOT (already bound) so it needs no extra bind. Exported
# because pipeline_env_activate.sh runs INSIDE the container and does not source
# this file — it inherits this via apptainer's env passthrough.
export CONTAINER_PYTHON_OVERLAY="${GEODESIC_CONTAINER_PYTHON_OVERLAY:-${CONTAINER_ROOT}/overlay/nemo_${CONTAINER_IMAGE_TAG}}"

# Packages the overlay carries (space-separated pip specs). These override or fill
# gaps in the image's site-packages — the reason for each is documented in
# docs/environment.md. Installed by pipeline_env_setup.sh's overlay step with --no-deps (a
# dependency closure could drag in a PyPI torch that shadows the image's
# CUDA-matched one).
#   peft    — image ships 0.13.2; the bridge recipes import modelopt, which
#             hard-requires >=0.17.0.
#   imageio — absent from the image; without it one diffusion test file fails at
#             COLLECTION, which fails the whole in-container unit-test run.
#   nv-grouped-gemm — absent from vanilla 26.04 (26.02.nemotron_3_super shipped it);
#             required by CutlassGroupedExperts (`moe_experts_impl: cutlass_grouped`,
#             the adopted Super-120B experts path — measured −15% s/iter). sdist-only
#             on PyPI: builds CUTLASS kernels in-container (~5 min), which is why the
#             overlay pip line carries --no-build-isolation (the isolated build env
#             has no torch; wheels like peft/imageio are unaffected by the flag).
CONTAINER_OVERLAY_PACKAGES="${GEODESIC_CONTAINER_OVERLAY_PACKAGES:-peft==0.18.1 imageio==2.37.0 nv-grouped-gemm==1.1.4.post8}"

# Apptainer cache/tmp for pulls and builds, from the profile. The guard below
# refuses to run if either resolves to $HOME.
export APPTAINER_CACHEDIR="${APPTAINER_CACHEDIR:-$CLUSTER_APPTAINER_CACHEDIR}"
export APPTAINER_TMPDIR="${APPTAINER_TMPDIR:-$CLUSTER_APPTAINER_TMPDIR}"

# ------------------------------------------------------------------------------
# Host paths bound into the container
#
# Every cluster binds its storage (CLUSTER_STORAGE_BINDS) and the checkout.
#
# REPO_DIR is bound by name. Apptainer binds $HOME by itself, which leaves a checkout
# outside $HOME (a clone on shared storage, a worktree) invisible inside the
# container, and --contain in $CONTAINER_EXTRA_FLAGS removes that implicit bind.
#
# A Slingshot cluster also binds the host libraries of CXI networking (the same
# set the BriCS recipe binds):
#   - Cray libfabric with the CXI provider  -> /host/opt/cray/libfabric/<ver>
#   - /usr/lib64 (libcxi.so.1, libnl-3)     -> /host/usr/lib64
#   - the Option B build output             -> /opt/slingshot
# The in-container paths are the official recipe's, so its build scripts and its ld
# ordering work unmodified. The image's own NCCL and CUDA libraries come first, and
# the host set fills the sonames the image lacks (the profile's activation hook has
# the LD_LIBRARY_PATH ordering).
# ------------------------------------------------------------------------------
CONTAINER_FABRIC_BINDS=""
if [ "$CLUSTER_FABRIC" = "slingshot" ]; then
    # The Slingshot NCCL stack, built inside this image against the host's libfabric
    # by pipeline_env_setup.sh's slingshot step (the official Isambard "Option B"
    # recipe). The shim binds it at /opt/slingshot, the path the BriCS recipe uses.
    CONTAINER_SLINGSHOT_DIR="${GEODESIC_CONTAINER_SLINGSHOT_DIR:-${CONTAINER_ROOT}/slingshot/nemo_${CONTAINER_IMAGE_TAG}}"
    CONTAINER_HOST_LIBFABRIC="${GEODESIC_CONTAINER_HOST_LIBFABRIC:-$CLUSTER_HOST_LIBFABRIC}"
    CONTAINER_FABRIC_BINDS=",${CONTAINER_HOST_LIBFABRIC}:/host${CONTAINER_HOST_LIBFABRIC}:ro,/usr/lib64:/host/usr/lib64:ro,${CONTAINER_SLINGSHOT_DIR}:/opt/slingshot"
fi
CONTAINER_BINDS="${GEODESIC_CONTAINER_BINDS:-${CLUSTER_STORAGE_BINDS},${REPO_DIR}${CONTAINER_FABRIC_BINDS}}"

# A site can give every job a node-local, job-scoped TMPDIR that apptainer does not bind, so
# inside the container that path lands on the image's read-only root and every mktemp, and every cache placed
# under TMPDIR (HybridEP's JIT among them), fails. An existing TMPDIR is bound at its own path; a missing one is
# not, since apptainer refuses a bind whose source does not exist. The training launcher sets its own TMPDIR
# under /tmp before it calls the shim, which this binds the same way.
if [ -n "${TMPDIR:-}" ] && [ -d "$TMPDIR" ]; then
    CONTAINER_BINDS="${CONTAINER_BINDS},${TMPDIR}"
fi

# Extra apptainer flags (debugging: e.g. --contain). Empty by default.
CONTAINER_EXTRA_FLAGS="${GEODESIC_CONTAINER_FLAGS:-}"

# ------------------------------------------------------------------------------
# Guards (memory hygiene — structural, not manual)
# ------------------------------------------------------------------------------
case "$APPTAINER_CACHEDIR" in "$HOME"*)
    echo "FATAL [env-config]: APPTAINER_CACHEDIR=$APPTAINER_CACHEDIR is under \$HOME (tiny quota)." >&2
    echo "Point it at project storage, e.g. $CLUSTER_APPTAINER_CACHEDIR" >&2
    return 1 2>/dev/null || exit 1;;
esac
case "$APPTAINER_TMPDIR" in "$HOME"*)
    echo "FATAL [env-config]: APPTAINER_TMPDIR=$APPTAINER_TMPDIR is under \$HOME (tiny quota)." >&2
    return 1 2>/dev/null || exit 1;;
esac

# ------------------------------------------------------------------------------
# env_config_require — validate that everything a RUN needs is present. Called by
# the exec shim and by every launcher (NOT by pipeline_env_setup.sh, whose job is
# to create these artifacts). Hard-fails with the fix command: a missing SIF must
# never silently degrade.
# ------------------------------------------------------------------------------
env_config_require() {
    local ok=1
    if [ ! -f "$CONTAINER_SIF_SOURCE" ]; then
        echo "FATAL [env-config]: SIF not found: $CONTAINER_SIF_SOURCE" >&2
        echo "  Fix: bash pipeline_env_setup.sh   (pulls $CONTAINER_IMAGE_URI)" >&2
        ok=0
    elif [ ! -f "${CONTAINER_SIF_SOURCE}.source.txt" ]; then
        # The sidecar is written only after a successful pull, so its absence means
        # the SIF is of unknown provenance (hand-copied, or a pull that died before
        # the atomic rename in an older setup). Launchers also echo this file into
        # every job log, so a missing sidecar means an unauditable run.
        echo "FATAL [env-config]: SIF present but provenance sidecar missing: ${CONTAINER_SIF_SOURCE}.source.txt" >&2
        echo "  The SIF's origin is therefore unverifiable (and may be a truncated pull)." >&2
        echo "  Fix: bash pipeline_env_setup.sh --only sif --force   (re-pulls and writes provenance)" >&2
        ok=0
    fi
    if [ "$CLUSTER_FABRIC" = "slingshot" ]; then
        if [ ! -f "$CONTAINER_SLINGSHOT_DIR/aws-ofi-nccl/lib/libnccl-net.so" ]; then
            echo "FATAL [env-config]: Slingshot NCCL stack not built: $CONTAINER_SLINGSHOT_DIR" >&2
            echo "  Fix: bash pipeline_env_setup.sh   (one-time, ~20 min on a GPU node)" >&2
            ok=0
        elif [ ! -L "$CONTAINER_SLINGSHOT_DIR/hostlibs/libcxi.so.1" ] && [ ! -e "$CONTAINER_SLINGSHOT_DIR/hostlibs/libcxi.so.1" ]; then
            # -L comes first: the symlink's /host/... target resolves only inside the
            # container, so on the host the link dangles and -e alone reports a good
            # build as missing.
            # A build from before the hostlibs directory passes the plugin check above,
            # and its plugin then cannot dlopen libcxi at run time. This branch names
            # the fix.
            echo "FATAL [env-config]: Slingshot build predates the hostlibs dir (no libcxi symlink):" >&2
            echo "  $CONTAINER_SLINGSHOT_DIR/hostlibs" >&2
            echo "  Fix: bash pipeline_env_setup.sh --force   (rebuild adds hostlibs)" >&2
            ok=0
        fi
        if [ ! -d "$CONTAINER_HOST_LIBFABRIC" ]; then
            echo "FATAL [env-config]: host libfabric not found: $CONTAINER_HOST_LIBFABRIC" >&2
            echo "  This is a cluster constant — override GEODESIC_CONTAINER_HOST_LIBFABRIC if the" >&2
            echo "  cluster's libfabric version changed (check: ls -d /opt/cray/libfabric/*)" >&2
            ok=0
        fi
    fi
    [ "$ok" = "1" ] || return 1
}

# ------------------------------------------------------------------------------
# env_config_stage: with a CONTAINER_STAGE_ROOT, make CONTAINER_SIF a current
# unpacked copy of CONTAINER_SIF_SOURCE on this node. Without one, do nothing.
# The exec shim calls it before every container command, and
# pipeline_env_setup.sh before its in-container steps.
#
# Where Apptainer cannot mount a SIF in the kernel it reads it through squashfuse,
# one user-space process that serves every file a container opens. Python's
# imports open thousands, so a container started from the SIF spends minutes on
# them. Unpacked to a directory on the node's own disk (`apptainer build
# --sandbox`), the same image is read as plain files.
#
# The copy is current while the source's size and modification time equal the
# ones recorded beside it. Shims that start together on one node take a lock, so
# one of them unpacks and the others wait. A copy that is out of date is moved
# aside, not deleted, because a container still running from it reads its files:
# the message names the directory to remove once no job uses it. Returns 1 when
# the source cannot be read or the unpacking fails. Its messages go to stderr,
# since callers capture the shim's stdout.
# ------------------------------------------------------------------------------
env_config_stage() {
    [ -n "$CONTAINER_STAGE_ROOT" ] || return 0
    local want stamp="${CONTAINER_SIF}.stamp"
    want="$(stat -c '%s %Y' "$CONTAINER_SIF_SOURCE")" || return 1
    if [ -d "$CONTAINER_SIF" ] && [ "$(cat "$stamp" 2>/dev/null)" = "$want" ]; then
        return 0
    fi
    mkdir -p "$CONTAINER_STAGE_ROOT" || return 1
    (
        flock 9 || exit 1
        if [ -d "$CONTAINER_SIF" ] && [ "$(cat "$stamp" 2>/dev/null)" = "$want" ]; then
            exit 0
        fi
        echo "[env-config] unpacking $CONTAINER_SIF_SOURCE to $CONTAINER_SIF on $(hostname)" >&2
        # --fix-perms: every unpacked directory is the account's to write, so the copy can be removed later.
        rm -rf "${CONTAINER_SIF}.partial" || exit 1
        mkdir -p "$APPTAINER_CACHEDIR" "$APPTAINER_TMPDIR" || exit 1
        apptainer build --sandbox --fix-perms "${CONTAINER_SIF}.partial" "$CONTAINER_SIF_SOURCE" >&2 || exit 1
        rm -f "$stamp" || exit 1
        if [ -e "$CONTAINER_SIF" ]; then
            local old
            old="${CONTAINER_SIF}.old.$(date +%s)"
            mv "$CONTAINER_SIF" "$old" || exit 1
            echo "[env-config] the earlier copy is now $old; remove it once no job on $(hostname) runs from it" >&2
        fi
        mv "${CONTAINER_SIF}.partial" "$CONTAINER_SIF" || exit 1
        echo "$want" > "$stamp"
    ) 9> "${CONTAINER_SIF}.lock"
}

# ------------------------------------------------------------------------------
# env_scrub_host_toolchain — unset the host toolchain and virtualenv variables
# that interactive host shells carry (CC/CXX=/usr/bin/g*-12, the HPC-SDK
# CUDA_HOME, site-packages include paths, LD_PRELOAD) and empty LD_LIBRARY_PATH.
# Inside the container they resolve, or half-resolve, through the $HOME bind and
# hijack the image's toolchain (observed: the NCCL build invoking a nonexistent
# /usr/bin/g++-12). Called by pipeline_env_exec.sh before every container command
# and by pipeline_env_setup.sh before the Slingshot build.
# ------------------------------------------------------------------------------
env_scrub_host_toolchain() {
    unset LD_PRELOAD PYTHONPATH VIRTUAL_ENV NCCL_LIBRARY \
          CC CXX CUDAHOSTCXX CUDA_HOME CPLUS_INCLUDE_PATH C_INCLUDE_PATH CUDNN_PATH
    export LD_LIBRARY_PATH=""
}
